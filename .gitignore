# Ignore everything by default
*

# Then un-ignore only what we want to publish
!tracker.html
!index.html
!.gitignore

# Agent veille emploi
!veille_agent/
!veille_agent/**
veille_agent/.env       # jamais committer les vraies clés

# GitHub Actions
!.github/
!.github/workflows/
!.github/workflows/*.yml

# GitHub Pages rapport
!docs/
!docs/**
